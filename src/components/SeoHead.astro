---
interface Props {
  title: string;
  description: string;
  path: string;
  structuredData?: Record<string, unknown>;
  noindex?: boolean;
}
const { title, description, path, structuredData, noindex } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const image = new URL('/assets/workshop-social.jpg', Astro.site).href;
const jsonLd = structuredData && JSON.stringify(structuredData).replace(/</g, '\\u003c');
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#f4f0e5" />
<meta name="robots" content={noindex ? 'noindex' : 'index, follow, max-image-preview:large'} />
{!noindex && <link rel="canonical" href={canonical} />}
<link rel="icon" type="image/png" href="/assets/workshop-icon.png" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="AskHermie" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
