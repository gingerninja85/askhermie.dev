---
import { kinds } from '../data/skills';

const { entries, heading, description } = Astro.props;
const topics = [...new Set<string>(entries.map((entry: { topic: string }) => entry.topic))].sort();
const types = { ...kinds, resource: 'Resource' };
const availableTypes = new Set(entries.map((entry: { kind: string }) => entry.kind));
---
  <div class="frame">
    <section id="catalog" class="catalog" aria-labelledby="headline">
      <header class="intro">
        <h1 id="headline">{heading}</h1>
        <p class="intro-description">{description}</p>
      </header>
      <div class="search-tools" hidden>
        <div class="search-box" role="search">
          <span class="magnifier" aria-hidden="true"></span>
          <label class="sr-only" for="search">Search by name or task</label>
          <input id="search" type="search" placeholder="Search by name or task" autocomplete="off" aria-controls="skill-list" />
          <kbd aria-hidden="true">/</kbd>
        </div>
      </div>
      <div class="filters" hidden>
        <div class="type-filter">
          <label for="topic" class="sr-only">Skill category</label>
          <select id="topic" aria-controls="skill-list">
            <option value="">All categories</option>
            {topics.map(topic => <option value={topic}>{topic}</option>)}
          </select>
        </div>
        <div class="type-filter">
          <label for="kind" class="sr-only">Entry type</label>
          <select id="kind" aria-controls="skill-list">
            <option value="">All entry types</option>
            {Object.entries(types).filter(([key]) => availableTypes.has(key)).map(([key, label]) => <option value={key}>{label}</option>)}
          </select>
        </div>
      </div>
      <div class="catalog-heading">
        <h2>Skill directory</h2>
        <p id="results" class="mono" role="status">{entries.length} entries</p>
      </div>
      <div id="skill-list" class="cards">
        {entries.map((skill: { name: string; slug: string; topic: string; kind: keyof typeof types; description: string; href: string; search: string; category?: string; anchor?: string }) => (
          <article class="card" id={skill.anchor} data-skill data-topic={skill.topic} data-kind={skill.kind}
            data-search={skill.search}>
            <h3><a href={skill.href}>{skill.name}</a></h3>
            <p>{skill.description}</p>
            <div class="card-meta">
              <span class="category">{skill.category ?? skill.topic}</span>
              <span class={`badge ${skill.kind}`}>{types[skill.kind]}</span>
            </div>
            <span class="card-arrow" aria-hidden="true">→</span>
          </article>
        ))}
      </div>
      <div class="empty" hidden>
        <h3>No matching entries</h3>
        <p>Try a shorter search or clear the filters.</p>
        <button type="button" id="reset">Clear search and filters</button>
      </div>
    </section>
  </div>
<script>
  const search = document.querySelector<HTMLInputElement>('#search')!;
  const kind = document.querySelector<HTMLSelectElement>('#kind')!;
  const results = document.querySelector('#results')!;
  const empty = document.querySelector<HTMLElement>('.empty')!;
  const cards = [...document.querySelectorAll<HTMLElement>('[data-skill]')];
  const category = document.querySelector<HTMLSelectElement>('#topic')!;
  const params = new URLSearchParams(location.search);
  const normalize = (value: string) => value.toLowerCase().replace(/[^\p{L}\p{N}]+/gu, ' ').trim();
  const searchable = cards.map(card => normalize(card.dataset.search ?? ''));

  function update() {
    const topic = category.value;
    const query = normalize(search.value);
    const terms = query ? query.split(' ') : [];
    let matches = 0;
    cards.forEach((card, index) => {
      const visible = (!topic || card.dataset.topic === topic)
        && (!kind.value || card.dataset.kind === kind.value)
        && terms.every(term => searchable[index].includes(term));
      card.hidden = !visible;
      if (visible) matches++;
    });
    results.textContent = `${matches} ${matches === 1 ? 'entry' : 'entries'}`;
    empty.hidden = matches > 0;
    for (const [key, value] of Object.entries({ q: search.value.trim(), topic, type: kind.value })) {
      if (value) params.set(key, value);
      else params.delete(key);
    }
    const queryString = params.toString();
    history.replaceState(history.state, '', location.pathname + (queryString ? '?' + queryString : '') + location.hash);
  }

  search.value = params.get('q') ?? '';
  category.value = params.get('topic') ?? '';
  if (category.selectedIndex < 0) category.selectedIndex = 0;
  kind.value = params.get('type') ?? '';
  if (kind.selectedIndex < 0) kind.selectedIndex = 0;
  document.querySelector<HTMLElement>('.search-tools')!.hidden = false;
  document.querySelector<HTMLElement>('.filters')!.hidden = false;
  search.addEventListener('input', update);
  kind.addEventListener('change', update);
  category.addEventListener('change', update);
  document.querySelector('#reset')!.addEventListener('click', () => {
    search.value = '';
    kind.value = '';
    category.value = '';
    update();
    search.focus();
  });
  document.addEventListener('keydown', event => {
    const target = event.target;
    if (event.key === '/' && !event.altKey && !event.ctrlKey && !event.metaKey
      && target instanceof HTMLElement && !target.closest('input, textarea, select, [contenteditable]')) {
      event.preventDefault();
      search.focus();
    }
  });
  update();
</script>
