---
import '../styles/registry.css';

const { title, description, path = '/' } = Astro.props;
const docs = 'https://hermes-agent.nousresearch.com/docs/';
const preview = import.meta.env.ASKHERMIE_PREVIEW || (import.meta.env.CF_PAGES_BRANCH && import.meta.env.CF_PAGES_BRANCH !== 'main');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {preview && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta name="theme-color" content="#f7f9fc" />
    <link rel="icon" href="/registry-mark.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="frame top-inner">
        <a class="wordmark" href="/"><img src="/registry-mark.svg" width="33" height="33" alt="" />AskHermie<span>.dev</span></a>
        <nav aria-label="Primary">
          <a href="/#catalog">Catalog</a>
          <a href="/resources/">Resources</a>
          <a href={docs}>Hermes docs <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="frame bottom">
      <span>AskHermie · Independent Hermes Agent skills catalog</span>
      <nav aria-label="Footer"><a href="/about/">About</a><a href="/resources/">Resources</a><a href="https://github.com/gingerninja85/askhermie.dev">GitHub ↗</a></nav>
    </footer>
  </body>
</html>
