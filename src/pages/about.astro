---
import Registry from '../layouts/Registry.astro';
import { officialCatalog } from '../data/skills';
---
<Registry title="About AskHermie" description="How AskHermie sources and labels Hermes Agent skill listings." path="/about/">
  <div class="frame detail about">
    <a class="back mono" href="/#catalog">← Browse skills</a>
    <header class="detail-heading">
      <h1>About AskHermie</h1>
      <p>An independent catalog for discovering and installing Hermes Agent skills.</p>
    </header>
    <div class="detail-body">
      <section>
        <h2>Where entries come from</h2>
        <ul>
          <li><strong>Official skills</strong> are listed in the <a href={officialCatalog}>Nous Research optional skills catalog</a>.</li>
          <li><strong>Third-party skills</strong> come from their own publishers and install as skills.</li>
          <li><strong>Plugins with skills</strong> are installed as plugins and include a skill alongside their other capabilities.</li>
        </ul>
        <p>Each entry links to its source and the upstream instructions used to check the install command and prerequisites.</p>
      </section>
      <section><h2>Resources archive</h2><p>The previous general-purpose reference collection is available at <a href="/resources/">Resources</a>.</p></section>
    </div>
  </div>
</Registry>
