---
import Workshop from '../layouts/Workshop.astro';
const description = 'How AskHermie grew from a Hermes Agent setup into a public workshop for troubleshooting, automation, security and hardware practice.';
---
<Workshop title="About the workshop — AskHermie" description={description}
  structuredData={{ '@context': 'https://schema.org', '@type': 'AboutPage', name: 'About the workshop', description }}>
  <header class="page-intro">
    <h1>About the workshop<span class="period">.</span></h1>
    <p class="lede">Hermie started as the Telegram-facing assistant in a Hermes Agent setup. AskHermie is where the useful parts of that work get written down.</p>
  </header>
  <div class="reading-layout">
    <div class="prose">
      <section>
        <h2>What gets published</h2>
        <p>The resource catalog records what a tool does, what you might use it for, and a first step. It covers AI agents and automation alongside systems troubleshooting, cybersecurity practice, firmware and small hardware projects.</p>
        <p>The build log links to reviewable work and records what happened upstream. A proposed change and an accepted change have different outcomes, and both are worth documenting.</p>
      </section>
      <section>
        <h2>How to use the notes</h2>
        <p>Start with a task you can reproduce in a disposable environment. Read the upstream instructions before running installation commands, and give integrations only the permissions they need. Use security exercises on the lab platform or on systems you own or administer with explicit permission.</p>
      </section>
    </div>
    <aside class="side-note">
      <h2>Follow the source</h2>
      <p><a href="https://hermes-agent.nousresearch.com/docs/">Hermes Agent documentation ↗</a></p>
      <p><a href="https://github.com/gingerninja85/askhermie.dev">Website and discovery notes ↗</a></p>
    </aside>
  </div>
</Workshop>
