---
import Workshop from '../layouts/Workshop.astro';

const description = 'An independent technical workshop for AI-assisted troubleshooting, automation, cybersecurity practice and small hardware projects.';
const destinations = [
  ['Resources', '/resources/', 'Search the catalog by task, tool or command.'],
  ['Skills', '/skills/', 'Find reusable instructions and plugins for Hermes Agent.'],
  ['Tools', '/tools/', 'Pick a tool for a specific troubleshooting or automation job.'],
  ['Lab', '/lab/', 'Try a small exercise in hardware or web security.'],
];
---
<Workshop title="AskHermie — An independent technical workshop" description={description}
  structuredData={{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'AskHermie', url: Astro.site?.href, description }}>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-intro">
      <p class="kicker"><span aria-hidden="true"></span> Independent technical workshop</p>
      <h1 id="home-title">The AskHermie<br />workshop<span class="period">.</span></h1>
      <p class="lede">A place to troubleshoot systems, put AI agents to work, and try small experiments in security and hardware.</p>
      <a class="button" href="/resources/#catalog">Search resources <span aria-hidden="true">↗</span></a>
    </div>
    <div class="hero-photo">
      <img src="/assets/workbench.webp" width="1200" height="1000" alt="" fetchpriority="high" />
    </div>
  </section>

  <div class="home-sections">
    <section class="home-index" aria-labelledby="index-title">
      <h2 id="index-title">Workshop index</h2>
      <ul class="index-list">
        {destinations.map(([label, href, detail]) => (
          <li><a href={href}><strong>{label}</strong><span>{detail}</span><b aria-hidden="true">↗</b></a></li>
        ))}
      </ul>
    </section>
    <aside class="featured" aria-labelledby="featured-title">
      <p class="kicker">From the build log</p>
      <h2 id="featured-title">Clearing stale dividers in RimSort</h2>
      <p>Importing a second XML mod list could leave dividers from the first import in place. The fix cleared that old state before loading the new list.</p>
      <a href="/build-log/#rimsort">Read the build note <span aria-hidden="true">↗</span></a>
    </aside>
  </div>
  <section class="home-bottom">
    <p>AskHermie grew out of a Hermes Agent setup. The workshop records what each tool does, where to start, and what happened when a fix went upstream.</p>
    <a href="/about/">About the workshop <span aria-hidden="true">↗</span></a>
  </section>
</Workshop>
